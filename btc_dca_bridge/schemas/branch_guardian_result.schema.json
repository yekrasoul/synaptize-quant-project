{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "branch", "head_sha", "base_sha", "classification", "auto_merge_eligible", "tests_passed", "protected_files_unchanged", "execution_config_safe", "ledger_unchanged", "runtime_blocked", "authorization", "activation", "production_enablement", "execution", "no_order_executed"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "branch": {"type": "string"}, "head_sha": {"type": "string"}, "base_sha": {"type": "string"},
    "classification": {"enum": ["SAFE_ENGINEERING", "SAFETY_SENSITIVE", "FAIL"]}, "auto_merge_eligible": {"type": "boolean"}, "manual_review_required": {"type": "boolean"},
    "guardian_bootstrap_version": {"const": 1}, "manual_bootstrap_approval_required": {"type": "boolean"}, "tests_passed": {"type": "boolean"}, "protected_files_unchanged": {"type": "boolean"}, "execution_config_safe": {"type": "boolean"}, "ledger_unchanged": {"type": "boolean"}, "runtime_blocked": {"type": "boolean"},
    "authorization": {"type": "string"}, "activation": {"type": "string"}, "production_enablement": {"type": "string"}, "execution": {"type": "string"}, "reason": {"type": "string"}, "no_order_executed": {"const": true}
  }
}
