{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "created_at_utc", "expires_at_utc", "repository_commit", "hostname", "pid", "platform", "python_version", "account_identity_fingerprint", "account_identity_status", "readiness_status", "check_results", "connectivity_result", "clock_result", "credential_scope_result", "account_mode_result", "liability_result", "instrument_result", "spot_availability_result", "quote_unit_limit_result", "monthly_budget_result", "unresolved_operations_result", "secret_hygiene_result", "filesystem_result", "operator_lock_result", "real_money_authorization", "status", "host_binding", "evidence_ttl_seconds", "dynamic_ttls_seconds", "wallet_observed_at_utc", "availability_observed_at_utc", "liability_observed_at_utc", "clock_observed_at_utc", "account_observed_at_utc", "instrument_observed_at_utc"],
  "properties": {
    "schema_version": {"const": "5.7.0"},
    "evidence_id": {"type": "string", "pattern": "^evidence-[a-f0-9]{32}$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "hostname": {"type": "string", "minLength": 1},
    "pid": {"type": "integer", "minimum": 1},
    "platform": {"type": "string", "minLength": 1},
    "python_version": {"type": "string", "minLength": 1},
    "account_identity_fingerprint": {"type": ["string", "null"]},
    "account_identity_status": {"enum": ["PROVEN", "ACCOUNT_IDENTITY_UNPROVEN"]},
    "readiness_status": {"enum": ["NOT_READY", "READY_FOR_OPERATOR_PREPARATION", "READY_FOR_SEPARATE_REAL_MONEY_AUTHORIZATION"]},
    "check_results": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["check_id", "category", "status", "required", "evidence", "reason", "remediation"], "properties": {"check_id": {"type": "string"}, "category": {"type": "string"}, "status": {"enum": ["PASS", "FAIL", "BLOCKED", "UNAVAILABLE", "NOT_APPLICABLE"]}, "required": {"type": "boolean"}, "evidence": {"type": "string"}, "reason": {"type": "string"}, "remediation": {"type": "string"}}}},
    "connectivity_result": {"type": "object", "additionalProperties": false, "required": ["status", "read_only", "endpoints"], "properties": {"status": {"enum": ["READS_OK", "READS_FAILED", "READS_UNAVAILABLE"]}, "read_only": {"const": true}, "endpoints": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["endpoint", "status", "reason", "read_only", "observed_at_utc", "response_contract_valid"], "properties": {"endpoint": {"type": "string"}, "status": {"enum": ["PASS", "FAIL", "UNAVAILABLE"]}, "reason": {"type": "string"}, "read_only": {"const": true}, "observed_at_utc": {"type": "string", "format": "date-time"}, "response_contract_valid": {"type": "boolean"}}}}, "probe_order_link_id": {"type": "string"}, "message": {"type": "string"}}},
    "clock_result": {"$ref": "#/$defs/check_result"},
    "credential_scope_result": {"$ref": "#/$defs/check_result"},
    "account_mode_result": {"$ref": "#/$defs/check_result"},
    "liability_result": {"$ref": "#/$defs/check_result"},
    "instrument_result": {"$ref": "#/$defs/check_result"},
    "spot_availability_result": {"$ref": "#/$defs/check_result"},
    "quote_unit_limit_result": {"type": "object", "additionalProperties": false, "required": ["symbol", "market_type", "side", "order_type", "market_unit", "quote_currency", "source_endpoint", "source_field", "unit", "maximum_quote_usdt", "authoritative", "observed_at_utc", "conclusion"], "properties": {"symbol": {"const": "BTCUSDT"}, "market_type": {"const": "spot"}, "side": {"const": "Buy"}, "order_type": {"const": "Market"}, "market_unit": {"const": "quoteCoin"}, "quote_currency": {"const": "USDT"}, "source_endpoint": {"type": "string"}, "source_field": {"type": "string"}, "unit": {"type": "string"}, "maximum_quote_usdt": {"type": ["string", "null"]}, "authoritative": {"type": "boolean"}, "observed_at_utc": {"type": "string", "format": "date-time"}, "conclusion": {"enum": ["CONFIRMED", "NOT_EXPOSED", "AMBIGUOUS"]}}},
    "monthly_budget_result": {"$ref": "#/$defs/check_result"},
    "unresolved_operations_result": {"$ref": "#/$defs/check_result"},
    "secret_hygiene_result": {"$ref": "#/$defs/check_result"},
    "filesystem_result": {"$ref": "#/$defs/check_result"},
    "operator_lock_result": {"$ref": "#/$defs/check_result"},
    "real_money_authorization": {"type": "object", "additionalProperties": false, "required": ["granted", "source", "required", "status"], "properties": {"granted": {"const": false}, "source": {"const": "none"}, "required": {"const": true}, "status": {"const": "NOT_AUTHORIZED"}}},
    "status": {"enum": ["EVIDENCE_COMPLETE_NOT_READY", "EVIDENCE_COMPLETE_READY_FOR_SEPARATE_AUTHORIZATION", "EVIDENCE_INCOMPLETE"]},
    "host_binding": {"const": "host-bound"},
    "evidence_ttl_seconds": {"const": 600},
    "dynamic_ttls_seconds": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "wallet_observed_at_utc": {"type": "string", "format": "date-time"},
    "availability_observed_at_utc": {"type": "string", "format": "date-time"},
    "liability_observed_at_utc": {"type": "string", "format": "date-time"},
    "clock_observed_at_utc": {"type": "string", "format": "date-time"},
    "account_observed_at_utc": {"type": "string", "format": "date-time"},
    "instrument_observed_at_utc": {"type": "string", "format": "date-time"}
  },
  "$defs": {"check_result": {"type": "object", "additionalProperties": false, "required": ["check_id", "category", "status", "required", "evidence", "reason", "remediation"], "properties": {"check_id": {"type": "string"}, "category": {"type": "string"}, "status": {"enum": ["PASS", "FAIL", "BLOCKED", "UNAVAILABLE", "NOT_APPLICABLE"]}, "required": {"type": "boolean"}, "evidence": {"type": "string"}, "reason": {"type": "string"}, "remediation": {"type": "string"}}}},
  "not": {"anyOf": [{"required": ["api_key"]}, {"required": ["api_secret"]}, {"required": ["authorization"]}, {"required": ["signature"]}, {"required": ["token"]}]}
}
