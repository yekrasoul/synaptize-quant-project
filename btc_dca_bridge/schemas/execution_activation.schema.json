{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "activation_id", "created_at_utc", "expires_at_utc", "status", "authorization_id", "authorization_sha256", "approval_id", "approval_sha256", "canary_manifest_id", "canary_manifest_sha256", "decision_id", "decision_sha256", "order_intent_id", "order_intent_sha256", "client_order_id", "exact_quote_amount_usdt", "calendar_month", "repository_commit_sha", "execution_safety_config_fingerprint", "production_contract_fingerprint", "account_identity_fingerprint", "one_shot_identity", "activation_nonce_digest", "standing_activation", "consumed", "no_order_executed"],
  "properties": {
    "schema_version": {"const": "5.4.0D"},
    "activation_id": {"type": "string", "pattern": "^activation-[a-f0-9]{32}$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ACTIVE", "EXPIRED", "CONSUMED", "REVOKED"]},
    "authorization_id": {"type": "string", "pattern": "^rmauth-[a-f0-9]{32}$"},
    "authorization_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approval_id": {"type": "string", "pattern": "^approval5b-[a-f0-9]{32}$"},
    "approval_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "canary_manifest_id": {"type": "string", "minLength": 1},
    "canary_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision_id": {"type": "string", "minLength": 1},
    "decision_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "order_intent_id": {"type": "string", "minLength": 1},
    "order_intent_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "client_order_id": {"type": "string", "pattern": "^dca-[a-f0-9]{32}$"},
    "exact_quote_amount_usdt": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "calendar_month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "repository_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "execution_safety_config_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "production_contract_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "account_identity_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "one_shot_identity": {"type": "string", "minLength": 1},
    "activation_nonce_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "standing_activation": {"const": false},
    "consumed": {"type": "boolean"},
    "no_order_executed": {"const": true}
  }
}
