{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synaptize-quant-project/schemas/execution/1.0.0",
  "title": "Execution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_id", "executed_at_utc", "asset", "quote_currency", "executed_usd", "reference_price_usdt", "status", "reconciliation"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "execution_id": {"type": "string", "pattern": "^execution_[A-Za-z0-9_-]+$"},
    "executed_at_utc": {"type": "string", "format": "date-time"},
    "asset": {"const": "BTC"},
    "quote_currency": {"const": "USDT"},
    "executed_usd": {"type": "number", "exclusiveMinimum": 0},
    "reference_price_usdt": {"type": "number", "exclusiveMinimum": 0},
    "btc_quantity": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "status": {"const": "reconciled"},
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "note"],
      "properties": {
      "source": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "decision_id": {"type": "string"},
    "canary_id": {"type": "string"},
    "approval_id": {"type": "string"},
    "order_id": {"type": "string"},
    "order_link_id": {"type": "string"},
    "execution_id_bybit": {"type": "string"},
    "fee": {"type": "number", "minimum": 0},
    "fee_asset": {"type": "string"}
  }
}
