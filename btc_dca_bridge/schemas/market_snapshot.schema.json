{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synaptize-quant-project/schemas/market_snapshot/1.0.0",
  "title": "MarketSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "captured_at_utc", "source_exchange", "market_type", "symbol", "current_price_usdt", "rolling_7d_high_usdt", "window_start_utc", "window_end_utc", "validation"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "snapshot_id": {"type": "string", "pattern": "^market_[A-Za-z0-9_-]+$"},
    "captured_at_utc": {"type": "string", "format": "date-time"},
    "source_exchange": {"enum": ["Bybit", "Binance", "KuCoin"]},
    "market_type": {"const": "spot"},
    "symbol": {"const": "BTCUSDT"},
    "current_price_usdt": {"type": "number", "exclusiveMinimum": 0},
    "rolling_7d_high_usdt": {"type": "number", "exclusiveMinimum": 0},
    "window_start_utc": {"type": "string", "format": "date-time"},
    "window_end_utc": {"type": "string", "format": "date-time"},
    "fear_greed_index": {"type": "integer", "minimum": 0, "maximum": 100},
    "market_data_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_resolution_seconds", "trade_level_exact"],
      "properties": {
        "observation_resolution_seconds": {"type": "integer", "enum": [60, 3600]},
        "trade_level_exact": {"const": false},
        "source": {"enum": ["bybit_api", "binance_api", "kucoin_api"]},
        "external_symbol": {"enum": ["BYBIT:BTCUSDT", "BINANCE:BTCUSDT", "KUCOIN:BTC-USDT"]},
        "primary_source": {"const": "bybit_api"},
        "primary_failure_category": {
          "type": ["string", "null"],
          "enum": [null, "SOURCE_UNAVAILABLE", "DATA_UNAVAILABLE", "SOURCE_MISMATCH", "INVALID_MARKET_IDENTITY", "INVALID_RESPONSE", "DATA_STALE", "INSUFFICIENT_HISTORY", "RATE_LIMITED", "INVALID_WINDOW", "CONTRADICTORY_PRICE_DATA"]
        },
        "fallback_attempted": {"type": "boolean"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_source_price_and_high", "full_168h_coverage", "fresh"],
      "properties": {
        "same_source_price_and_high": {"const": true},
        "full_168h_coverage": {"const": true},
        "fresh": {"const": true}
      }
    }
  }
}
