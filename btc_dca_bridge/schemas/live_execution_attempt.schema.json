{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["schema_version","attempt_id","created_at_utc","approval_id","approval_sha256","canary_manifest_id","canary_manifest_sha256","decision_id","decision_sha256","order_intent_id","order_intent_sha256","client_order_id","quote_amount_usdt","safe_request_fingerprint","repository_commit_sha","account_identity_fingerprint","calendar_month","safety_gate_fingerprint","reconciliation_fingerprint","status","no_order_executed"],"properties":{"schema_version":{"const":"5.4.0B"},"attempt_id":{"type":"string","pattern":"^attempt5b-[a-f0-9]{32}$"},"created_at_utc":{"type":"string","format":"date-time"},"approval_id":{"type":"string","pattern":"^approval5b-[a-f0-9]{32}$"},"approval_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"canary_manifest_id":{"type":"string","minLength":1},"canary_manifest_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"decision_id":{"type":"string","minLength":1},"decision_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"order_intent_id":{"type":"string","minLength":1},"order_intent_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"client_order_id":{"type":"string","pattern":"^dca-[a-f0-9]{32}$"},"quote_amount_usdt":{"type":"string","pattern":"^[0-9]+(?:\\.[0-9]+)?$"},"safe_request_fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"},"repository_commit_sha":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},"account_identity_fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"},"calendar_month":{"type":"string","pattern":"^[0-9]{4}-(0[1-9]|1[0-2])$"},"safety_gate_fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"},"reconciliation_fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"},"status":{"const":"PREPARED_FOR_SUBMISSION"},"no_order_executed":{"const":true}}}
