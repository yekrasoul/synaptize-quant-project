{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synaptize-quant-project/schemas/production_status/6.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "captured_at_utc", "repository_commit", "hostname", "software_health", "production_readiness", "preauthorization_status", "real_money_authorization", "active_blockers", "blocker_ids", "contract_capabilities", "account_identity_status", "account_mode_status", "credential_scope_status", "secret_hygiene_status", "spot_availability_status", "quote_unit_limit_status", "liabilities_status", "clock_status", "connectivity_status", "monthly_budget_status", "monthly_spent_usdt", "remaining_monthly_budget_usdt", "canonical_execution_count", "unresolved_operations", "canonical_ledger_status", "evidence_status", "checked_in_execution_safety", "overall_operator_state"],
  "properties": {
    "schema_version": {"const": "6.0.0"},
    "snapshot_id": {"type": "string", "pattern": "^run_[0-9]{8}T[0-9]{6}Z_[A-Za-z0-9][A-Za-z0-9_-]{7,63}$"},
    "captured_at_utc": {"type": "string", "format": "date-time"}, "repository_commit": {"type": ["string", "null"]}, "hostname": {"type": "string", "minLength": 1},
    "software_health": {"type": "string"}, "production_readiness": {"enum": ["NOT_READY", "READY_FOR_OPERATOR_PREPARATION", "READY_FOR_SEPARATE_REAL_MONEY_AUTHORIZATION", "UNAVAILABLE"]}, "preauthorization_status": {"enum": ["BLOCKED", "READY_FOR_OPERATOR_PREPARATION", "READY_FOR_SEPARATE_REAL_MONEY_AUTHORIZATION", "UNAVAILABLE"]},
    "real_money_authorization": {"type": "object", "additionalProperties": false, "required": ["granted", "source", "required", "status"], "properties": {"granted": {"const": false}, "source": {"const": "none"}, "required": {"const": true}, "status": {"const": "NOT_AUTHORIZED"}}},
    "active_blockers": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["blocker_id", "category", "severity", "source", "status", "first_observed_at_utc", "last_observed_at_utc", "retryable", "external_dependency", "remediation", "evidence", "authorization_impact"], "properties": {"blocker_id": {"type": "string"}, "category": {"type": "string"}, "severity": {"type": "string"}, "source": {"type": "string"}, "status": {"type": "string"}, "first_observed_at_utc": {"type": "string", "format": "date-time"}, "last_observed_at_utc": {"type": "string", "format": "date-time"}, "retryable": {"type": "boolean"}, "external_dependency": {"type": "boolean"}, "remediation": {"type": "string"}, "evidence": {"type": "string"}, "authorization_impact": {"type": "string"}}}},
    "blocker_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "contract_capabilities": {"type": "object", "additionalProperties": false, "required": ["exchange", "market_type", "symbol", "spot_quote_availability_source", "spot_quote_availability_supported", "quote_unit_maximum_source", "quote_unit_maximum_supported", "market_unit_quote_coin_supported", "instrument_minimum_supported", "account_mode_supported", "verified_at_utc", "documentation_version"], "properties": {"exchange": {"const": "Bybit"}, "market_type": {"const": "spot"}, "symbol": {"const": "BTCUSDT"}, "spot_quote_availability_source": {"type": ["string", "null"]}, "spot_quote_availability_supported": {"type": "boolean"}, "quote_unit_maximum_source": {"type": ["string", "null"]}, "quote_unit_maximum_supported": {"type": "boolean"}, "market_unit_quote_coin_supported": {"type": "boolean"}, "instrument_minimum_supported": {"type": "boolean"}, "account_mode_supported": {"type": "boolean"}, "verified_at_utc": {"type": "string", "format": "date-time"}, "documentation_version": {"type": "string"}}},
    "account_identity_status": {"type": "string"}, "account_mode_status": {"type": "string"}, "credential_scope_status": {"type": "string"}, "secret_hygiene_status": {"type": "string"}, "spot_availability_status": {"type": "string"}, "quote_unit_limit_status": {"type": "string"}, "liabilities_status": {"type": "string"}, "clock_status": {"type": "string"}, "connectivity_status": {"type": "string"},
    "monthly_budget_status": {"type": "string"}, "monthly_spent_usdt": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"}, "remaining_monthly_budget_usdt": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"}, "canonical_execution_count": {"type": "integer", "minimum": 0}, "unresolved_operations": {"type": "boolean"}, "canonical_ledger_status": {"type": "string"}, "evidence_status": {"type": "string"},
    "checked_in_execution_safety": {"type": "object", "additionalProperties": false, "required": ["live_execution_enabled", "kill_switch", "order_submission"], "properties": {"live_execution_enabled": {"type": "boolean"}, "kill_switch": {"type": "boolean"}, "order_submission": {"type": "string"}}},
    "overall_operator_state": {"enum": ["HEALTHY_OBSERVE_ONLY", "ACTION_REQUIRED", "RECONCILIATION_REQUIRED", "EXTERNAL_DEPENDENCY_BLOCKED", "CORRUPT"]}
  }
}
