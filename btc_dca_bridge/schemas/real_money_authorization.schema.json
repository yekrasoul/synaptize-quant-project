{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authorization_id", "created_at_utc", "expires_at_utc", "status", "approval_id", "approval_sha256", "canary_manifest_id", "canary_manifest_sha256", "decision_id", "decision_sha256", "order_intent_id", "order_intent_sha256", "client_order_id", "exact_quote_amount_usdt", "exchange", "market_type", "symbol", "side", "order_type", "market_unit", "is_leverage", "order_filter", "calendar_month", "repository_commit_sha", "execution_safety_config_fingerprint", "production_contract_fingerprint", "account_identity_fingerprint", "one_shot_identity", "operator_confirmation_digest", "standing_authorization", "consumed", "no_order_executed"],
  "properties": {
    "schema_version": {"const": "5.4.0C"},
    "authorization_id": {"type": "string", "pattern": "^rmauth-[a-f0-9]{32}$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "status": {"enum": ["AUTHORIZED", "EXPIRED", "CONSUMED", "REVOKED"]},
    "approval_id": {"type": "string", "pattern": "^approval5b-[a-f0-9]{32}$"},
    "approval_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "canary_manifest_id": {"type": "string", "minLength": 1},
    "canary_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision_id": {"type": "string", "minLength": 1},
    "decision_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "order_intent_id": {"type": "string", "minLength": 1},
    "order_intent_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "client_order_id": {"type": "string", "pattern": "^dca-[a-f0-9]{32}$"},
    "exact_quote_amount_usdt": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "exchange": {"const": "Bybit"}, "market_type": {"const": "spot"}, "symbol": {"const": "BTCUSDT"}, "side": {"const": "Buy"}, "order_type": {"const": "Market"}, "market_unit": {"const": "quoteCoin"}, "is_leverage": {"const": 0}, "order_filter": {"const": "Order"},
    "calendar_month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "repository_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "execution_safety_config_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "production_contract_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "account_identity_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "one_shot_identity": {"type": "string", "minLength": 1},
    "operator_confirmation_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "standing_authorization": {"const": false},
    "consumed": {"type": "boolean"},
    "no_order_executed": {"const": true}
  }
}
